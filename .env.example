# Moat configuration (copy to .env and fill in values)

# Server bind address
MOAT_BIND=0.0.0.0:3200

# PostgreSQL connection URL
MOAT_DATABASE_URL=postgres://moat:moat@localhost:5432/moat

# Google OAuth2 Client ID (from console.cloud.google.com)
MOAT_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ES256 private key for C4M token signing
MOAT_C4M_PRIVATE_KEY=./c4m-private.pem

# Token claims
MOAT_C4M_ISSUER=moat
MOAT_C4M_AUDIENCE=moq-relay

# Default token lifetime (1 hour)
MOAT_TOKEN_LIFETIME=3600
